{
  "name": "milan-automobile-accessoires",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node --watch server.cjs\"",
    "dev:web": "vite",
    "dev:server": "node --watch server.cjs",
    "start": "node server.cjs",
    "build": "vite build",
    "check": "node --check server.cjs && node --check server/store.cjs && node --check server/auth.cjs",
    "lint": "eslint .",
    "test": "npm run test:server",
    "test:server": "node --test server/backend.test.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.577.0",
    "multer": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "7.18.1",
    "sharp": "^0.35.3",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "vitest": "^4.0.18"
